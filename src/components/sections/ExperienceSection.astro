---
import { getCollection } from 'astro:content';

const experiences = await getCollection('experience');
const educations = await getCollection('education');
---

<section id="experience" class="py-12 border-t border-border-dark flex flex-col md:flex-row gap-8 md:gap-16">
  <div class="md:w-1/3">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Trayectoria</h2>
    <p class="text-zinc-500 text-sm mt-2">Mi experiencia profesional actual y mi formación académica de base.</p>
  </div>
  <div class="md:w-2/3 flex flex-col gap-10">
    <!-- Experiencia -->
    {experiences.length > 0 && (
      <div>
        <h3 class="text-lg font-bold text-zinc-200 mb-6 flex items-center gap-2">
          <span class="w-1.5 h-5 bg-accent-blue rounded-full"></span>
          Experiencia Laboral
        </h3>
        <div class="space-y-8 border-l border-border-dark pl-4 ml-1">
          {experiences.map((exp) => (
            <div class="relative">
              <span class="absolute -left-[21px] top-1.5 w-2 h-2 rounded-full bg-accent-blue ring-4 ring-bg-dark"></span>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                <div>
                  <h4 class="font-semibold text-zinc-100 text-base">{exp.data.role}</h4>
                  <p class="text-zinc-400 text-sm">{exp.data.company}</p>
                </div>
                <span class="text-xs font-semibold text-blue-400 bg-accent-blue/10 px-2.5 py-0.5 rounded-full self-start mt-0.5">
                  {exp.data.startDate} — {exp.data.current ? 'Presente' : exp.data.endDate}
                </span>
              </div>
              <ul class="mt-3 list-disc list-inside text-zinc-400 text-sm space-y-1.5">
                {exp.data.description.map((desc) => (
                  <li>{desc}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Formación -->
    {educations.length > 0 && (
      <div>
        <h3 class="text-lg font-bold text-zinc-200 mb-6 flex items-center gap-2">
          <span class="w-1.5 h-5 bg-accent-blue rounded-full"></span>
          Educación
        </h3>
        <div class="space-y-8 border-l border-border-dark pl-4 ml-1">
          {educations.map((edu) => (
            <div class="relative">
              <span class="absolute -left-[21px] top-1.5 w-2 h-2 rounded-full bg-accent-blue ring-4 ring-bg-dark"></span>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                <div>
                  <h4 class="font-semibold text-zinc-100 text-base">{edu.data.degree}</h4>
                  <p class="text-zinc-400 text-sm">{edu.data.institution}</p>
                </div>
                <span class="text-xs font-semibold text-zinc-400 bg-zinc-900 border border-border-dark px-2.5 py-0.5 rounded-full self-start mt-0.5">
                  {edu.data.status}
                </span>
              </div>
              <ul class="mt-3 list-disc list-inside text-zinc-400 text-sm space-y-1.5">
                {edu.data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
