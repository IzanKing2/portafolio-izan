---
import { technologies } from '../../data/technologies';
import Badge from '../ui/Badge.astro';

const categories = {
  frontend: 'Frontend',
  backend: 'Backend',
  database: 'Bases de Datos',
  devops: 'DevOps y Entorno',
  methodology: 'Metodología',
} as const;

type CategoryKey = keyof typeof categories;

const groupedTechnologies = technologies.reduce(
  (acc, tech) => {
    if (!acc[tech.category]) {
      acc[tech.category] = [];
    }
    acc[tech.category].push(tech.name);
    return acc;
  },
  {} as Record<CategoryKey, string[]>,
);
---

<section
  id="skills"
  class="py-12 border-t border-border-dark flex flex-col md:flex-row gap-8 md:gap-16"
>
  <div class="md:w-1/3">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Habilidades</h2>
    <p class="text-zinc-500 text-sm mt-2">
      Tecnologías y metodologías en las que tengo formación académica o experiencia práctica.
    </p>
  </div>
  <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-6">
    {
      (Object.keys(categories) as CategoryKey[]).map((key) => {
        const techs = groupedTechnologies[key] || [];
        const label = categories[key];
        return (
          <div class="border border-border-dark bg-card-dark/30 rounded-lg p-5">
            <h3 class="text-sm font-semibold tracking-wide uppercase text-zinc-300 mb-3">
              {label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {techs.map((techName) => (
                <Badge
                  label={techName}
                  variant={
                    key === 'methodology' ||
                    techName === 'Astro' ||
                    techName === 'TypeScript' ||
                    techName === 'Tailwind CSS'
                      ? 'tech'
                      : 'default'
                  }
                />
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
