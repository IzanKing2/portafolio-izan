---
interface Props {
  label: string;
  variant?: 'default' | 'tech';
  class?: string;
}

const { label, variant = 'default', class: className = '' } = Astro.props;

const baseStyles =
  'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border select-none transition-colors';
const variants = {
  default: 'bg-zinc-900 text-zinc-300 border-border-dark hover:border-zinc-700',
  tech: 'bg-accent-blue/10 text-blue-400 border-accent-blue/20 hover:bg-accent-blue/20',
};
---

<span class={`${baseStyles} ${variants[variant]} ${className}`}>
  {label}
</span>
