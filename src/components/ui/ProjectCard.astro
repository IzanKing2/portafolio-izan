---
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  githubUrl?: string | undefined;
  liveUrl?: string | undefined;
  featured?: boolean | undefined;
}

const { title, description, tags, githubUrl, liveUrl, featured = false } = Astro.props;
---

<div
  class={`flex flex-col h-full bg-card-dark border rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${featured ? 'border-accent-blue/40 hover:border-accent-blue/60 shadow-md shadow-accent-blue/5' : 'border-border-dark hover:border-zinc-700'}`}
>
  <div class="p-6 flex-1 flex flex-col">
    {
      featured && (
        <span class="inline-flex items-center gap-1.5 self-start text-xs font-semibold text-accent-blue mb-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path
              fill-rule="evenodd"
              d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.6 3.1-1.096 4.637c-.192.813.693 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.405-1.02l-1.096-4.638 3.6-3.1c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.83-4.401Z"
              clip-rule="evenodd"
            />
          </svg>
          Destacado
        </span>
      )
    }

    <h3 class="text-xl font-bold text-zinc-100 mb-2 group-hover:text-accent-blue transition-colors">
      {title}
    </h3>

    <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-6">
      {tags.map((tag) => <Badge label={tag} variant="tech" />)}
    </div>
  </div>

  <div
    class="px-6 py-4 bg-zinc-950/40 border-t border-border-dark flex items-center justify-between gap-4"
  >
    {
      githubUrl ? (
        <Button
          href={githubUrl}
          variant="secondary"
          size="sm"
          class="flex items-center gap-2"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver repositorio de GitHub para ${title}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            viewBox="0 0 16 16"
            class="w-4 h-4"
          >
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          <span>Código</span>
        </Button>
      ) : (
        <div />
      )
    }

    {
      liveUrl && (
        <Button
          href={liveUrl}
          variant="primary"
          size="sm"
          class="flex items-center gap-1.5"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver demo en vivo para ${title}`}
        >
          <span>Demo</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-3.5 h-3.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
            />
          </svg>
        </Button>
      )
    }
  </div>
</div>
