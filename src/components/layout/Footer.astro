---
import { profile } from '../../data/profile';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border-dark bg-bg-dark py-8 mt-auto">
  <div
    class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <div class="text-zinc-500 text-xs sm:text-sm text-center sm:text-left">
      <p>&copy; {currentYear} {profile.name}. Todos los derechos reservados.</p>
      <p class="mt-1 text-[10px] text-zinc-600">
        Construido con Astro 5, Tailwind v4 y Spec-Driven Development.
      </p>
    </div>

    <nav aria-label="Enlaces de redes sociales y contacto">
      <ul class="flex items-center gap-4 text-zinc-400">
        <li>
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs sm:text-sm hover:text-accent-blue transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue rounded px-2 py-1"
            aria-label="Ir al perfil de GitHub de Izan"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs sm:text-sm hover:text-accent-blue transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue rounded px-2 py-1"
            aria-label="Ir al perfil de LinkedIn de Izan"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href={`mailto:${profile.email}`}
            class="text-xs sm:text-sm hover:text-accent-blue transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue rounded px-2 py-1"
            aria-label={`Enviar correo a ${profile.email}`}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
